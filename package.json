{
	"name": "pdm-task-provider",
	"displayName": "PDM Task Provider",
	"description": "Task provider for Python Development Master",
	"version": "1.1.0",
	"publisher": "knowsuchagency",
	"repository": "https://github.com/knowsuchagency/pdm-task-provider",
	"icon": "static/python_icon.png",
	"engines": {
		"vscode": "^1.45.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onCommand:workbench.action.tasks.runTask",
		"onCommand:pdmTaskProvider.runScript",
		"workspaceContains:**/pyproject.toml"
	],
	"main": "./out/extension",
	"contributes": {
		"taskDefinitions": [
			{
				"type": "pdm",
				"required": [
					"task"
				],
				"properties": {
					"task": {
						"type": "string",
						"description": "The PDM task to customize"
					},
					"file": {
						"type": "string",
						"description": "The pyproject.toml that provides the task, relative to the workspace folder. Can be omitted."
					}
				}
			}
		],
		"configuration": {
			"title": "PDM Task Provider",
			"properties": {
				"pdmTaskProvider.pdmCommand": {
					"type": "string",
					"default": "",
					"scope": "resource",
					"markdownDescription": "Command used to invoke pdm, e.g. `./pw pdm` or `python -m pdm`. When empty, `./pw pdm` (`.\\pw.bat pdm` on Windows) is used if the project has a [pyprojectx](https://pyprojectx.github.io) `pw` wrapper, otherwise `pdm`."
				},
				"pdmTaskProvider.codeLens": {
					"type": "boolean",
					"default": true,
					"scope": "resource",
					"description": "Show a Run button above each script in [tool.pdm.scripts] in pyproject.toml."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -b",
		"watch": "tsc -b -w",
		"test": "npm run compile && node out/test/scriptLocations.test.js"
	},
	"devDependencies": {
		"@types/node": "^12.12.0",
		"@types/vscode": "^1.45.0",
		"@typescript-eslint/eslint-plugin": "^3.0.2",
		"@typescript-eslint/parser": "^3.0.2",
		"eslint": "^7.1.0",
		"typescript": "^4.0.2"
	},
	"dependencies": {
		"@iarna/toml": "^3.0.0"
	}
}
